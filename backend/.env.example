# Copy this to .env and fill in real values before running in production

# Database (defaults to local SQLite file if unset)
DATABASE_URL=sqlite:///./fieldproof.db

# Auth
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Redis / Celery (task queue for AI processing jobs)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Object storage (AWS S3 / Azure Blob) - wire up in app/services/storage.py
STORAGE_BUCKET=fieldproof-uploads
STORAGE_REGION=us-east-1

# ── AI providers ──────────────────────────────────────────────────────────────
# OpenAI — used for Whisper (STT) and GPT-4o-mini (LLM extraction)
OPENAI_API_KEY=

# Anthropic — reserved for model-comparison experiments (Phase 5 evaluation)
ANTHROPIC_API_KEY=

# ── AI model selection ────────────────────────────────────────────────────────
# Chat/LLM extraction model (JSON mode required)
AI_MODEL_CHAT=gpt-4o-mini

# Vision-language model (stubbed — future work)
AI_MODEL_VISION=gpt-4o-mini

# Whisper model name for the hosted API
AI_MODEL_WHISPER=whisper-1

# ── STT settings ──────────────────────────────────────────────────────────────
# Set to false to ablate the domain vocabulary prompt effect (eval Phase 5)
STT_USE_DOMAIN_PROMPT=true

# Default trade for LLM extraction when not specified by job type
DEFAULT_TRADE=electrical

# ── LLM extraction settings ───────────────────────────────────────────────────
# Prompt version used for field extraction (matches app/prompts/extract_vN.md)
# Bump to v2 etc. when creating new prompt iterations for ablation
LLM_PROMPT_VERSION=v1
